{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signalaf.com/schemas/exchange-signal/1.0",
  "title": "Exchange Signal v1.0",
  "description": "Input document for a Contribution Exchange signal (spec §6). Mirrors ExchangeSignalInputSchema in lib/exchange-gateway/src/signal-schema.ts. A signal declares a problem, request, challenge, bounty, verification, discovery, or experiment; it creates no obligations and never advances exchange state.",
  "type": "object",
  "required": ["schema_version", "type", "title", "summary", "description", "desired_outcome", "scope", "constraints", "participation", "submission", "verification", "consideration", "follow_on", "timestamps"],
  "properties": {
    "schema_version": { "const": "exchange-signal/1.0" },
    "signal_id": { "type": "string", "minLength": 3, "maxLength": 200, "description": "Optional. Auto-generated by the Steward when absent." },
    "type": { "enum": ["problem", "request", "challenge", "bounty", "verification", "discovery", "experiment"] },
    "challenge_kind": { "enum": ["puzzle", "constraint_preservation", "governance_reasoning", "minimal_intervention", "provenance", "capability"] },
    "title": { "type": "string", "minLength": 3, "maxLength": 300 },
    "summary": { "type": "string", "minLength": 10, "maxLength": 2000 },
    "description": { "type": "string", "minLength": 10, "maxLength": 20000 },
    "desired_outcome": {
      "type": "object",
      "required": ["kind", "description"],
      "properties": {
        "kind": { "enum": ["artifact", "answer", "finding", "proof", "score", "result"] },
        "media_types": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
        "description": { "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["evidence_id", "kind", "uri", "observed_at", "claim"],
        "properties": {
          "evidence_id": { "type": "string", "minLength": 1, "maxLength": 200 },
          "kind": { "type": "string", "minLength": 1, "maxLength": 200 },
          "uri": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "digest": { "type": "string", "maxLength": 500 },
          "observed_at": { "type": "string", "minLength": 1, "description": "ISO 8601 datetime preferred; any non-empty string accepted." },
          "claim": { "type": "string", "minLength": 1, "maxLength": 4000 }
        }
      }
    },
    "scope": {
      "type": "object",
      "required": ["included"],
      "properties": {
        "included": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
        "excluded": { "type": "array", "maxItems": 50, "default": [], "items": { "type": "string", "minLength": 1, "maxLength": 1000 } }
      }
    },
    "constraints": {
      "type": "object",
      "properties": {
        "production_write": { "type": "boolean", "default": false },
        "repository_write": { "type": "boolean", "default": false },
        "private_data_access": { "type": "boolean", "default": false },
        "third_party_contact": { "type": "boolean", "default": false },
        "financial_authority": { "type": "boolean", "default": false },
        "network_access": {
          "type": "object",
          "required": ["mode"],
          "properties": {
            "mode": { "enum": ["public_read_only", "none", "allowlisted"] },
            "allowed_hosts": { "type": "array", "maxItems": 50, "items": { "type": "string", "minLength": 1, "maxLength": 500 } }
          }
        },
        "required_behaviors": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } }
      }
    },
    "participation": {
      "type": "object",
      "properties": {
        "visibility": { "enum": ["public", "publisher_visible", "participants_only", "private"], "default": "public" },
        "eligibility": { "enum": ["open", "restricted", "invited"], "default": "open" },
        "maximum_attempts_per_actor": { "type": "integer", "minimum": 1, "maximum": 100, "default": 3 },
        "concurrent_attempts_per_actor": { "type": "integer", "minimum": 1, "maximum": 10, "default": 1 },
        "anonymous_attempts": { "type": "boolean", "default": false },
        "identity_assurance": { "type": "string", "minLength": 1, "maxLength": 200, "default": "authenticated_exchange_actor" }
      }
    },
    "submission": {
      "type": "object",
      "required": ["accepted_media_types", "required_fields"],
      "properties": {
        "accepted_media_types": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
        "maximum_bytes": { "type": "integer", "minimum": 1, "maximum": 10000000, "default": 262144 },
        "artifact_references_allowed": { "type": "boolean", "default": true },
        "required_fields": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 200 } }
      }
    },
    "verification": {
      "type": "object",
      "required": ["mode", "verifier", "inputs", "checks", "result_contract"],
      "properties": {
        "mode": { "enum": ["deterministic", "hybrid", "manual"] },
        "verifier": {
          "type": "object",
          "required": ["verifier_id", "version", "digest", "runtime"],
          "properties": {
            "verifier_id": { "type": "string", "minLength": 1, "maxLength": 200 },
            "version": { "type": "string", "minLength": 1, "maxLength": 100 },
            "digest": { "type": "string", "minLength": 1, "maxLength": 500 },
            "runtime": { "type": "string", "minLength": 1, "maxLength": 200 }
          }
        },
        "inputs": {
          "type": "object",
          "required": ["signal_revision_hash"],
          "additionalProperties": true,
          "properties": {
            "signal_revision_hash": { "type": "string", "minLength": 1, "maxLength": 500 }
          }
        },
        "checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "object",
            "required": ["check_id", "description"],
            "properties": {
              "check_id": { "type": "string", "minLength": 1, "maxLength": 200 },
              "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
              "required": { "type": "boolean", "default": true }
            }
          }
        },
        "result_contract": {
          "type": "object",
          "required": ["outcomes", "score_range", "passing_score"],
          "properties": {
            "outcomes": { "type": "array", "minItems": 1, "items": { "enum": ["passed", "failed", "inconclusive", "verifier_error"] } },
            "score_range": {
              "type": "object",
              "required": ["minimum", "maximum"],
              "properties": {
                "minimum": { "type": "integer", "minimum": 0, "maximum": 100 },
                "maximum": { "type": "integer", "minimum": 0, "maximum": 100 }
              }
            },
            "passing_score": { "type": "integer", "minimum": 0, "maximum": 100 }
          }
        }
      }
    },
    "consideration": {
      "type": "object",
      "required": ["mode", "advertised", "creates_obligation"],
      "properties": {
        "mode": { "enum": ["fixed", "maximum", "negotiable"] },
        "advertised": { "type": "boolean" },
        "creates_obligation": { "const": false, "description": "Signals never create obligations." },
        "currency": { "type": "string", "minLength": 3, "maxLength": 3, "description": "ISO 4217 currency code." },
        "amount": { "type": "string" },
        "maximum_amount": { "type": "string" },
        "note": { "type": "string", "maxLength": 2000 }
      }
    },
    "follow_on": {
      "type": "object",
      "required": ["mode", "commitment_automatic", "authorization_automatic"],
      "properties": {
        "mode": { "enum": ["none", "domain_review", "proposal_allowed", "invite_to_propose", "draft_proposal"] },
        "qualification_required": { "type": "boolean", "default": true },
        "proposal_template": {
          "type": "object",
          "required": ["contribution_kind"],
          "properties": {
            "contribution_kind": { "type": "string", "minLength": 1, "maxLength": 200 },
            "copy_signal_evidence": { "type": "boolean", "default": true },
            "copy_signal_constraints": { "type": "boolean", "default": true }
          }
        },
        "commitment_automatic": { "const": false, "description": "A signal never produces a Commitment automatically." },
        "authorization_automatic": { "const": false, "description": "A signal never produces an Authorization automatically." }
      }
    },
    "timestamps": {
      "type": "object",
      "required": ["created_at"],
      "properties": {
        "created_at": { "type": "string", "minLength": 1, "description": "ISO 8601 datetime preferred; any non-empty string accepted." },
        "published_at": { "type": "string", "minLength": 1 },
        "accepts_attempts_until": { "type": "string", "minLength": 1 },
        "expires_at": { "type": "string", "minLength": 1 }
      }
    },
    "labels": { "type": "array", "maxItems": 30, "items": { "type": "string", "minLength": 1, "maxLength": 100 } },
    "lineage": {
      "type": "object",
      "default": { "parent_signal_id": null, "derived_from": [] },
      "properties": {
        "parent_signal_id": { "type": ["string", "null"], "maxLength": 200, "default": null },
        "derived_from": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "required": ["kind", "reference"],
            "properties": {
              "kind": { "type": "string", "minLength": 1, "maxLength": 200 },
              "reference": { "type": "string", "minLength": 1, "maxLength": 2000 }
            }
          }
        }
      }
    }
  }
}
