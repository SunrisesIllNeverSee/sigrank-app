{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/recompute",
      "schedule": "11 6 * * *"
    }
  ],
  "routes": [
    {
      "src": "^/$",
      "transforms": [
        {
          "type": "response.headers",
          "op": "append",
          "target": {
            "key": "Vary"
          },
          "args": ["Accept", "Accept-Encoding"]
        }
      ],
      "continue": true
    }
  ]
}
